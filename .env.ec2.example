# Copy this file to .env.ec2 on the EC2 instance and fill the deployment values.

# Public URLs
VITE_API_BASE_URL=http://YOUR_EC2_PUBLIC_IP:8080
VITE_MEETVAULT_AUTO_SYNC_ENABLED=false
FRONTEND_ORIGIN=http://YOUR_EC2_PUBLIC_IP:4173
FRONTEND_ORIGINS=http://YOUR_EC2_PUBLIC_IP:4173,http://localhost:5173,http://127.0.0.1:5173

# Supabase frontend config
VITE_SUPABASE_URL=https://lebajsmvtyvltydhobuv.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_M94esE5IeHHnFZUjM9CWqQ_K6S8gWCr

# MCP OAuth apps
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://YOUR_EC2_PUBLIC_IP:8080/mcp/github/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://YOUR_EC2_PUBLIC_IP:8080/mcp/slack/callback
SLACK_USER_OAUTH_SCOPES=users:read users:read.email search:read
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://YOUR_EC2_PUBLIC_IP:8080/mcp/slack/callback
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_REDIRECT_URI=http://YOUR_EC2_PUBLIC_IP:8080/mcp/salesforce/callback
SALESFORCE_LOGIN_URL=https://login.salesforce.com
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=http://YOUR_EC2_PUBLIC_IP:8080/mcp/notion/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://YOUR_EC2_PUBLIC_IP:8080/mcp/gmail/callback

# Backend vector/transcription config
GRAPH_TIMEOUT_SECONDS=60
MEETVAULT_AUTO_SYNC_ENABLED=false
MEETVAULT_AUTO_SYNC_INTERVAL_SECONDS=60
MEETVAULT_AUTO_SYNC_LIMIT=50
POST_MEETING_EMAIL_ENABLED=true
POST_MEETING_NOTIFICATION_STORE_PATH=/data/post_meeting_notifications.json
MEETVAULT_CHAT_URL=http://YOUR_EC2_PUBLIC_IP:4173
CHROMA_COLLECTION_NAME=meetvault_transcripts
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
WHISPER_MODEL_SIZE=tiny
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# RAG / SLM
RAG_MODEL=qwen2.5:7b
OLLAMA_HOST=http://host.docker.internal:11434
