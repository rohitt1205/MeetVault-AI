# Microsoft / Azure
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=
GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
GRAPH_TIMEOUT_SECONDS=30

# Backend
BACKEND_PORT=8000
MEETVAULT_AUTO_SYNC_ENABLED=false
MEETVAULT_AUTO_SYNC_INTERVAL_SECONDS=60
MEETVAULT_AUTO_SYNC_LIMIT=50
POST_MEETING_EMAIL_ENABLED=true
POST_MEETING_NOTIFICATION_STORE_PATH=./post_meeting_notifications.json
MEETVAULT_CHAT_URL=http://127.0.0.1:5173

# Frontend
VITE_API_BASE_URL=http://localhost:8000
VITE_MEETVAULT_AUTO_SYNC_ENABLED=false
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ChromaDB
CHROMA_DB_PATH=./chroma_db
CHROMA_COLLECTION_NAME=meetvault_transcripts

# Embeddings
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Video transcription fallback
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# RAG answer generation
RAG_MODEL=qwen2.5:7b
OLLAMA_HOST=http://127.0.0.1:11434

# JWT / future backend auth validation
JWT_SECRET=

# MCP tool connections
MCP_CONNECTION_STORE_PATH=./mcp_connections.json
FRONTEND_ORIGIN=http://127.0.0.1:5173
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://127.0.0.1:8000/mcp/github/callback
